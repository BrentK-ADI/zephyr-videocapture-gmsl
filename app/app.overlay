/ {
    chosen {
        camera_sensor = &imx335;
    };
};


&imx335 {
    /* The camera initialization needs to happen after GMSL is running due to
       I2C tunnelling */
    zephyr,deferred-init;
};

&csi_interface {
    /* The CSI interface initialization needs to happen after the camera is
       initialized (now manually in code) as the driver verifies the camera is
       ready as part of its bringup */
    zephyr,deferred-init;
};

&gpioc {
    status = "okay";
};

&csi_i2c {
    gmsl_ser: max96717@42 {
        compatible = "adi,max96717";
        reg = <0x42>;
    };

    gmsl_deser: max96724@27 {
        compatible = "adi,max96724";
        reg = <0x27>;
        i2c-mux-gpios = <&gpioc 7 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>;
    };
};

/* Reassign User Button to 'E' for exposure */
&user_button {
    zephyr,code = <INPUT_KEY_E>;
};

/ {
    extra_keys {
        compatible = "gpio-keys";
        /* Add the tamper button and use it for gain */
        tamp_button: tamper_button {
            label = "Tamp";
            gpios = <&gpioe 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
            zephyr,code = <INPUT_KEY_G>;
        };
    };
};
